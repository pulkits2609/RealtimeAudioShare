{
  "name": "audioshare-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "build:desktop": "tauri build --no-bundle",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "smoke:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.73.0",
    "motion": "^12.23.24",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.0.0",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
